# ==========================================================================
# Gaucho Weather — plantilla de variables de entorno
#
# Copiala a .env y completá los valores. .env NUNCA se commitea.
#
#   cp .env.example .env
#
# Generar los secretos:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ==========================================================================

# --- Entorno ---------------------------------------------------------------
# 'production' o 'developer'. Define qué archivo de config/ se carga.
DJANGO_ENV=production

# --- Secretos (obligatorios) ------------------------------------------------
# El proceso no arranca si falta alguno.
SECRET_KEY=
SECRET_KEY_JWT=
TOMORROW_API_KEY=

# Clave de Google usada por el backend para geocodificación inversa.
# Restringila por API (Geocoding) y por IP del servidor.
GOOGLE_MAPS_API_KEY=

# --- Hosts y CORS (obligatorios en producción) ------------------------------
# Separados por coma, sin espacios. Sin comodines.
ALLOWED_HOSTS=api.gauchoweather.com,gauchoweather.com
CORS_ALLOWED_ORIGINS=https://gauchoweather.com
CSRF_TRUSTED_ORIGINS=https://gauchoweather.com

# URL pública del frontend. Se usa para armar los enlaces de los correos.
FRONTEND_URL=https://gauchoweather.com

# --- Base de datos ----------------------------------------------------------
POSTGRES_DB=gaucho_weather
POSTGRES_USER=gaucho
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Límite de peticiones ---------------------------------------------------
# Tomorrow.io factura por request: esto protege el servicio y la factura.
THROTTLE_ANON=60/hour
THROTTLE_USER=600/hour

# --- Correo -----------------------------------------------------------------
# Por defecto se imprime en consola. Para enviar de verdad, usá el backend SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@gauchoweather.com

# --- Seguridad de transporte ------------------------------------------------
SECURE_SSL_REDIRECT=true
# Subilo a 31536000 (un año) recién cuando confirmes que el certificado renueva
# bien: los navegadores recuerdan esta política y es difícil de revertir.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# --- Observabilidad ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_LEVEL_SQL=WARNING

# Publica /api/doc y /api/redoc. Dejalo apagado en producción.
ENABLE_API_DOCS=false

# --- Frontend (build de Vite) -----------------------------------------------
# Se compila dentro del bundle: es pública por naturaleza. Restringila por
# referrer HTTP en la consola de Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE_URL=https://api.gauchoweather.com
