# Copy to .env and adjust. This file is committed; .env is not.
# Keep it in sync with docker-compose.yml, docker-compose.prod.yml and backend/config/settings/.

# --- Host ports (checked free with find_free_port.sh) ---
BACKEND_PORT=8001           # dev only: Django runserver
FRONTEND_PORT=5173          # dev: Vite; prod: nginx (e.g. 8080)

# --- Database (inside Compose the host is always "db", port 5432) ---
DB_NAME=gaucho
DB_USER=gaucho
DB_PASSWORD=change-me       # REQUIRED in prod, use a strong value

# --- Django ---
DJANGO_SECRET_KEY=change-me                 # REQUIRED in prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1    # REQUIRED in prod (e.g. clima.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=                # prod: https://clima.example.com
TRUSTED_PROXY_COUNT=                        # reverse proxies in front of Django (VPS: global nginx + frontend nginx = 2); dev 0, prod default 2
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REGISTER_RATE=10/hour
THROTTLE_PUBLIC_FORECAST_RATE=60/hour       # GET /api/pronostico/ per IP (a stale cell costs ~7 Open-Meteo calls)
THROTTLE_PLACES_RATE=300/hour               # GET /api/lugares/ and /reverso/ per IP, shared bucket
THROTTLE_PLANS_RATE=300/hour                # GET /api/planes/ per IP
THROTTLE_PASSWORD_RESET_RATE=5/hour         # POST /api/auth/password/reset/ per IP (each one sends an email)

# --- Archiver data sources ---
# Free tier (non-commercial, evaluation). Commercial launch needs a paid plan:
# https://customer-api.open-meteo.com/v1/forecast and
# https://customer-ensemble-api.open-meteo.com/v1/ensemble plus the API key.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPEN_METEO_API_KEY=
OPEN_METEO_HISTORICAL_URL=https://historical-forecast-api.open-meteo.com/v1/forecast   # past weather per lote (commercial: customer- prefix + key, Professional plan)
LOTE_FORECAST_ON_CREATE=true      # a new or moved lote fetches its cell's forecast at once (not at the next 6-hourly run)
HISTORY_BACKFILL_ON_CREATE=true   # a new or moved lote loads its cell's last 90 days in the background
SMN_LOOKBACK_DAYS=3         # daily SMN files re-read on each run (recovers missed days)
SMN_DATOHORARIO_URL=https://ssl.smn.gob.ar/dpd/descarga_opendata.php?file=observaciones/datohorario{date}.txt

# --- Custom alerts ---
ALERTS_MAX_FORECAST_AGE_HOURS=12   # older forecasts are not evaluated (no alerts from stale data)
# Web Push (VAPID). Empty = no push (inbox and email still work). Generate a pair once with
# `npx web-push generate-vapid-keys` and keep it: a new pair drops every browser subscription.
PUSH_ALLOWED_HOSTS=   # empty = browser push services only (fcm.googleapis.com, push.services.mozilla.com, push.apple.com, notify.windows.com); any other host is refused
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                 # SECRET, never commit it
VAPID_SUBJECT=mailto:soporte@example.com   # contact for the push services (mailto: or https:)

# --- Places (Georef AR, CC BY 4.0, commercial use allowed) ---
GEOREF_API_URL=https://apis.datos.gob.ar/georef/api
PLACES_CACHE_SECONDS=86400  # place search and reverse answers, 1 day

# --- Payments: Mercado Pago subscriptions in pesos (Doc/funcionalidades/pagos.md) ---
# Both empty = payments off (the plans page shows no "Suscribirme"). From the Mercado Pago
# panel, "Tus integraciones" > your app: use the TEST-... credentials of a test seller for the
# sandbox, the production ones (APP_USR-...) only in prod.
MERCADOPAGO_ACCESS_TOKEN=          # SECRET, never commit it
MERCADOPAGO_WEBHOOK_SECRET=        # SECRET: "Webhooks > Configurar notificaciones" > clave secreta
MERCADOPAGO_API_URL=https://api.mercadopago.com

# --- Email (trial notices, password reset, alerts) ---
# Dev default: console backend, emails are printed in the backend/worker logs.
# Prod default: smtp; set the EMAIL_* values of your provider (e.g. Resend SMTP: smtp.resend.com:587).
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Gaucho Weather <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:5173   # prod: https://clima.example.com (links inside emails)

# --- Set by Compose, listed for reference (only needed when running outside Compose) ---
# DJANGO_SETTINGS_MODULE=config.settings.dev   # dev | prod | test
# DB_HOST=db
# DB_PORT=5432
# REDIS_URL=redis://redis:6379
# VITE_API_PROXY_TARGET=http://backend:8000    # frontend dev server proxy for /api

# --- Frontend build: satellite layer of the lote map (optional) ---
# Empty = EOxCloudless 2016 (Sentinel-2, 10 m, CC BY 4.0, no key): blurry past zoom 15.
# Sharper: Esri World Imagery with an ArcGIS Location Platform API key (basemaps privilege,
# restricted by referrer because the key ships in the JS bundle). Esri uses {y}/{x} order:
#   VITE_SATELLITE_TILES_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}?token=<key>
#   VITE_SATELLITE_ATTRIBUTION=Powered by Esri | Esri, Maxar, Earthstar Geographics
#   VITE_SATELLITE_MAX_ZOOM=19
# docker-compose.yml passes them to the Vite dev server; docker-compose.prod.yml passes them as
# build args (Vite inlines them at build time).
VITE_SATELLITE_TILES_URL=
VITE_SATELLITE_ATTRIBUTION=
VITE_SATELLITE_MAX_ZOOM=
