# Copy to .env and adjust. This file is committed; .env is not.
# Keep it in sync with docker-compose.yml, docker-compose.prod.yml and backend/config/settings/.

# --- Host ports (checked free with find_free_port.sh) ---
BACKEND_PORT=8001           # dev only: Django runserver
FRONTEND_PORT=5173          # dev: Vite; prod: nginx (e.g. 8080)

# --- Database (inside Compose the host is always "db", port 5432) ---
DB_NAME=gaucho
DB_USER=gaucho
DB_PASSWORD=change-me       # REQUIRED in prod, use a strong value

# --- Django ---
DJANGO_SECRET_KEY=change-me                 # REQUIRED in prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1    # REQUIRED in prod (e.g. clima.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=                # prod: https://clima.example.com
TRUSTED_PROXY_COUNT=                        # reverse proxies in front of Django (VPS: global nginx + frontend nginx = 2); dev 0, prod default 2
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REGISTER_RATE=10/hour

# --- Archiver data sources ---
# Free tier (non-commercial, evaluation). Commercial launch needs a paid plan:
# https://customer-api.open-meteo.com/v1/forecast and
# https://customer-ensemble-api.open-meteo.com/v1/ensemble plus the API key.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPEN_METEO_API_KEY=
SMN_LOOKBACK_DAYS=3         # daily SMN files re-read on each run (recovers missed days)
SMN_DATOHORARIO_URL=https://ssl.smn.gob.ar/dpd/descarga_opendata.php?file=observaciones/datohorario{date}.txt

# --- Set by Compose, listed for reference (only needed when running outside Compose) ---
# DJANGO_SETTINGS_MODULE=config.settings.dev   # dev | prod | test
# DB_HOST=db
# DB_PORT=5432
# REDIS_URL=redis://redis:6379
# VITE_API_PROXY_TARGET=http://backend:8000    # frontend dev server proxy for /api
