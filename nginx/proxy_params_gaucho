# Cabeceras que necesita el backend detrás del proxy.
#
# X-Forwarded-Proto es la clave: Django lo lee vía SECURE_PROXY_SSL_HEADER para
# saber que la conexión original era HTTPS. Sin esto, con SECURE_SSL_REDIRECT
# activo, el backend redirige en bucle.

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;

proxy_redirect off;
proxy_connect_timeout 10s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;
