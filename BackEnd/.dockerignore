# Entorno virtual de Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Archivos y carpetas de configuración local
.env
*.env
*.env.*

# OJO: acá NO va una regla que excluya migrations/.
# La versión anterior tenía `**/migrations/*`, lo que dejaba la imagen sin
# migraciones: `manage.py migrate` no encontraba nada que aplicar y la base
# quedaba sin tablas.

# Archivos temporales
*.log
*.sqlite3
db.sqlite3
*.bak

# Artefactos generados dentro del contenedor
staticfiles/
media/

# Control de versiones
.git/
.gitignore

# Archivos de IDE/editor
.vscode/
.idea/
